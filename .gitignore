# Terraform local directories and provider binaries
.terraform/
.terraform.lock.hcl

# State files (contain sensitive resource IDs and outputs)
*.tfstate
*.tfstate.*

# Plan files and variable files with credentials
*.tfplan
*.tfvars
*.tfvars.json

